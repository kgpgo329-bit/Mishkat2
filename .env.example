# Gemini AI (Server-side only — never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Project Configuration (mishkat2)
FIREBASE_PROJECT_ID=mishkat2
FIREBASE_AUTH_DOMAIN=mishkat2.firebaseapp.com
FIREBASE_STORAGE_BUCKET=mishkat2.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1075636519899
FIREBASE_APP_ID=1:1075636519899:web:c1b65c5c474a2f13c9ddfe

# Firebase Server-side Service Account (Optional / for production Firestore admin)
# Path to service-account.json or individual env vars
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage Backend Selection: "memory" (default for tests/dev) or "firestore"
MISHKAT_STORAGE=memory
